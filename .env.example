# Anthropic API key. Required only for live model runs and the scenario
# evaluation suite — the offline test suite runs without it.
ANTHROPIC_API_KEY=

# Agent runtime
AGENTOPS_MODEL=claude-opus-5
AGENTOPS_EFFORT=medium           # low | medium | high | xhigh | max
AGENTOPS_MAX_STEPS=8
AGENTOPS_MAX_TOKENS=4096

# Business data is simulated against a fixed date so evaluation results stay
# stable as real time passes. See docs/design-decisions.md (DD-008).
AGENTOPS_SIMULATED_TODAY=2026-10-12
