# --- Credentials -----------------------------------------------------------
# Only the key for the provider you select below is needed. Required for live
# model runs and the scenario evaluation suite; the offline test suite runs
# without any credential.
#
# This file is a template. Copy it to .env (which is gitignored) and fill in
# your key there.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Provider --------------------------------------------------------------
AGENTOPS_PROVIDER=openai          # anthropic | openai

# Model id. Leave blank to use the provider default (claude-opus-5 for
# anthropic, gpt-5 for openai). Run `make preflight` to see which models your
# credential can actually reach — availability varies by account.
AGENTOPS_MODEL=

# Reasoning models accept a reasoning-effort parameter; older chat models reject
# the request outright. Set false if preflight reports an unknown-parameter error.
AGENTOPS_REASONING_EFFORT_SUPPORTED=true

# --- Agent runtime ---------------------------------------------------------
AGENTOPS_EFFORT=medium            # low | medium | high | xhigh | max
AGENTOPS_MAX_STEPS=8
AGENTOPS_MAX_TOKENS=4096

# Business data is simulated against a fixed date so evaluation results stay
# stable as real time passes. See docs/design-decisions.md (DD-008).
AGENTOPS_SIMULATED_TODAY=2026-10-12

# --- The public surface ----------------------------------------------------
# Everything here is off or small by default, so a deployment that forgets to
# configure the demo gets the safe configuration rather than the open one.
# See docs/design-decisions.md (DD-015).

# POST /runs accepts arbitrary customer text. On a public origin that is an open
# prompt field with your key behind it, so it answers 404 unless you opt in.
# Turn it on locally to drive the agent over HTTP; leave it off in production.
AGENTOPS_OPEN_RUNS_ENABLED=false

# Live mode: let the demo page run a scenario against the real model. Off by
# default, and the kill switch — clearing it degrades every live request to a
# recorded run with a visible notice rather than breaking the page.
AGENTOPS_DEMO_LIVE_ENABLED=false

# Live runs per visitor per hour, keyed on client IP. Spoofable, which is why
# the token budget below is keyed on nothing.
AGENTOPS_DEMO_LIVE_RUNS_PER_HOUR=3

# Tokens the demo may spend on live runs per day. A scenario costs roughly
# 5,800, so this is about 20 runs. NOTE: counted per server instance, so a
# platform running several multiplies the real ceiling — the page says so.
AGENTOPS_DEMO_LIVE_DAILY_TOKEN_BUDGET=120000

# Live runs in flight at once. The rate limit is per visitor, so without this a
# burst of distinct addresses can start an unbounded number of paid runs.
AGENTOPS_DEMO_LIVE_MAX_CONCURRENT=2
